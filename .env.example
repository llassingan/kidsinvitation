# Copy to .env.local (or set in the shell / hosting dashboard).
# NEXT_PUBLIC_* is inlined for Client Components; a twin without the prefix wins
# at build time and keeps the copy out of the browser bundle.

# Sections: false hides a block without deleting its markup.
NEXT_PUBLIC_SECTION_COVER=true
NEXT_PUBLIC_SECTION_EVENT=true
NEXT_PUBLIC_SECTION_DRESSCODE=true
NEXT_PUBLIC_SECTION_LOCATION=true
NEXT_PUBLIC_SECTION_GIFT=true
NEXT_PUBLIC_SECTION_WISHES=true
NEXT_PUBLIC_SECTION_FOOTER=true

# Child
NEXT_PUBLIC_CHILD_NICKNAME=Nama Panggilan
NEXT_PUBLIC_CHILD_FULL_NAME=Nama Lengkap Anak
NEXT_PUBLIC_CHILD_ILLUSTRATION=/img/baby-portrait.webp

# Parents
NEXT_PUBLIC_FATHER_NAME=Nama Ayah
NEXT_PUBLIC_MOTHER_NAME=Nama Ibu

# Event. EVENT_TITLE is the whole occasion: "Aqiqah" or "Aqiqah & Khitanan".
NEXT_PUBLIC_EVENT_TITLE=Aqiqah
NEXT_PUBLIC_EVENT_DATE=2026-12-20
NEXT_PUBLIC_EVENT_START=09:00
NEXT_PUBLIC_EVENT_END=12:00
NEXT_PUBLIC_EVENT_TIMEZONE=Asia/Makassar
NEXT_PUBLIC_EVENT_TIMEZONE_LABEL=WITA
NEXT_PUBLIC_DRESS_CODE=

# Venue
NEXT_PUBLIC_VENUE_NAME=
NEXT_PUBLIC_VENUE_ADDRESS=
NEXT_PUBLIC_VENUE_NOTE=
NEXT_PUBLIC_MAPS_URL=

# Gift: an empty bank hides the account card.
NEXT_PUBLIC_GIFT_INTRO=
NEXT_PUBLIC_GIFT_BANK=
NEXT_PUBLIC_GIFT_ACCOUNT_NUMBER=
NEXT_PUBLIC_GIFT_ACCOUNT_HOLDER=
NEXT_PUBLIC_GIFT_NOTE=

# Wishes, sound, SEO
NEXT_PUBLIC_SHOW_PUBLIC_WISHES=true
NEXT_PUBLIC_AUDIO_ENABLED=true
NEXT_PUBLIC_AUDIO_SRC=
NEXT_PUBLIC_AUDIO_VOLUME=0.35
# Deployed origin, no trailing slash (https://undangan.contoh.com). The share
# card absolutizes /og.jpg against it, so localhost here yields no preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SEO_DESCRIPTION=Undangan syukuran aqiqah dan khitanan putra kami.
